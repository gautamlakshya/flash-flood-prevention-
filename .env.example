# Database
DATABASE_URL=postgresql://user:password@db:5432/flashflood

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Environment
ENV=development
SECRET_KEY=super-secret-key

# External APIs (Placeholders)
INSAT_API_KEY=your_insat_key_here
IMD_API_KEY=your_imd_key_here
DWR_API_KEY=your_dwr_key_here
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Open-Meteo Rainfall Intake (Chungthang Basin)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_LATITUDE=27.6033
OPEN_METEO_LONGITUDE=88.6475
OPEN_METEO_TIMEOUT_SECONDS=10
RAINFALL_STALE_THRESHOLD_MINUTES=180

# Multi-Channel Alerting (Web Push & SMS Ready)
ALERT_NOTIFICATIONS_ENABLED=true
ALERT_COOLDOWN_MINUTES=60
ALERT_ADMIN_KEY=your_secure_admin_key_for_test_alerts

# Standards-based Web Push (VAPID RFC 8292)
# Generate a keypair with: npx web-push generate-vapid-keys
# Or Python: from py_vapid import Vapid; v = Vapid(); v.generate_keys()
WEB_PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:alerts@chungthang-flood-warning.org

# SMS Channel (Plug-and-play TRAI DLT Compliant Interface)
# Kept disabled by default until verified DLT entity and template IDs are registered.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=SKMFLW

# External Cron Ingestion Secret (e.g. for cron-job.org)
INGESTION_CRON_SECRET=

# Simulation
DEMO_MODE=true
